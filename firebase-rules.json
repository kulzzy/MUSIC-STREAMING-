{
  "rules": {
    ".read": false,
    ".write": false,
    "songs": {
      ".read": true,
      "$songId": {
        ".write": "auth != null && auth.uid === 'ghCxTlIe3oV3Ft9qAFwXtiywDin2'"
      }
    },
    "settings": {
      ".read": true,
      ".write": "auth != null && auth.uid === 'ghCxTlIe3oV3Ft9qAFwXtiywDin2'"
    },
    "winner": {
      ".read": true,
      ".write": "auth != null && auth.uid === 'ghCxTlIe3oV3Ft9qAFwXtiywDin2'"
    },
    "votes": {
      ".read": true,
      "$songId": {
        "$month": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid && !data.exists() && newData.exists()",
            ".validate": "newData.hasChildren(['qualifiedAt'])",
            "qualifiedAt": { ".validate": "newData.isNumber()" },
            "$other": { ".validate": false }
          }
        }
      }
    }
  }
}